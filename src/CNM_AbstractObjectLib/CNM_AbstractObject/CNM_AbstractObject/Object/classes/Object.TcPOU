| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

*)

PROPERTY FINAL address :__XWORD
]]></Declaration>
      <Get Name="Get" Id="{43ecf11c-07b5-4bb7-8888-8513710c732d}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[address := THIS;
]]></ST>
        </Implementation>
      </Get>
    </Property>
