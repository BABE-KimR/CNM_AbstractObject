]]></Declaration>
      <Get Name="Get" Id="{b41adac5-ce06-45fd-a1b8-5f921d53b93d}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[name := THIS^.objectName;
