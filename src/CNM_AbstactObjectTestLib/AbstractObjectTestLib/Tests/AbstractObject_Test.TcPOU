<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.8">
  <POU Name="AbstractObject_Test" Id="{f24d8d58-e47e-4e35-9d01-ac9ffc31242e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
short summary
=================
This is an simple Test for the IObject interface. This class containes tests for IObject implementations.

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

methods and properties
=========================

*)

FUNCTION_BLOCK AbstractObject_Test EXTENDS TcUnit.FB_TestSuite
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	objectToTest1		:CNM_AbstractObject.IObject;
	objectToTest2		:CNM_AbstractObject.IObject;
	testPrefixObject1	:Tc2_System.T_MaxString;
	testPrefixObject2	:Tc2_System.T_MaxString;	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF (THIS^.isInputValidationSuccessful()) THEN
	THIS^.hasHashcode();
	THIS^.isEqualToItself();
	THIS^.isValid();
	THIS^.hashcodesAreDifferent();
	THIS^.isNotEqualToOther();
	THIS^.validAddress();
	THIS^.cloneTests();
	THIS^.deepCloneTests();
END_IF
]]></ST>
    </Implementation>
    <Method Name="cloneTest" Id="{bcf56cd8-db3d-438f-8ba0-8a93b8010cbf}">
      <Declaration><![CDATA[(*

short summary
=================
Test checks if the ``clone`` method works properly,
it performs different tests depending on the clone result

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

parameters
=================

*)

METHOD PRIVATE cloneTest
VAR_INPUT
	(* object that should perform the test *)
	object		:CNM_AbstractObject.IObject;
END_VAR
VAR
	clonedObject		:CNM_AbstractObject.IObject;
	result				:CNM_ReturnTypes.CloneResult;
	memoryArea			:Tc2_System.E_TcMemoryArea;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RETURN(NOT TcUnit.TEST_ORDERED(THIS^.createTestName(object, 'cloneTest')));

result := object.clone(clonedObject => clonedObject);

CASE result OF
CNM_ReturnTypes.CloneResult.CLONE_IS_NOT_SUPPORTED:
	THIS^.AssertTrue(clonedObject = 0, 'object does not support clone output clonedObject must be 0');
CNM_ReturnTypes.CloneResult.FAILED:
	THIS^.AssertTrue(FALSE, 'clone failed');
	THIS^.AssertTrue(clonedObject = 0, 'output clonedObject must be 0');  
CNM_ReturnTypes.CloneResult.SUCCESS:
	THIS^.AssertFalse(object.isEqual(clonedObject), 'cloned object must be NOT equal to source object');
	IF (object.isObjectValid(clonedObject)) THEN
		THIS^.AssertTrue(
			object.className = clonedObject.className,
			'cloned object must have the same class name as source object'
		);
		THIS^.AssertTrue(
			object.address <> clonedObject.address,
			'clonedObject.address must be unequal to the address of the source object.address'
		);
		memoryArea := Tc2_System.F_CheckMemoryArea(pData := clonedObject.address, nSize := SIZEOF(__XWORD));
		THIS^.AssertTrue(
			memoryArea = Tc2_System.E_TcMemoryArea.Dynamic,
			'Tc2_System.F_CheckMemoryArea(clonedObject.address, SIZEOF(__XWORD)) must return Tc2_System.E_TcMemoryArea.Dynamic'
		);
		THIS^.AssertTrue(
			Condition	:= ((clonedObject.address MOD SIZEOF(__XWORD)) = 0),
			Message 	:= 'clonedObject.address modulo SIZEOF(__XWORD) must be 0'
		);
	ELSE
		THIS^.AssertTrue(FALSE,'cloned object must be a valid object');
	END_IF 
	 
ELSE
	THIS^.AssertTrue(FALSE, 'invalid return from clone method');
	THIS^.AssertTrue(clonedObject = 0, 'output clonedObject must be 0'); 
END_CASE

IF (object.isObjectValid(clonedObject)) THEN
	clonedObject.destruct();
END_IF
TcUnit.TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="cloneTests" Id="{ed73aee7-1df5-4288-b76e-9de52edd4f5a}">
      <Declaration><![CDATA[(*

short summary
=================
Calls :ref:`AbstractObject_Test.cloneTest` for the injected
objects ``objectToTest1`` and ``objectToTest2``

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

*)

METHOD PRIVATE cloneTests
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.cloneTest(THIS^.objectToTest1);
THIS^.cloneTest(THIS^.objectToTest2);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="createTestName" Id="{3f5c866a-1b58-407e-b677-dae71b10b407}">
      <Declaration><![CDATA[(*

short summary
=================
creates a test name prefix for the test names

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

parameters
=================
:return: prefix for the test names for the specific object

*)

METHOD PRIVATE createTestName :Tc2_System.T_MaxString
VAR_INPUT
	(* object for which a prefix, for the test names, is to be generated *)
	object		:CNM_AbstractObject.IObject;
	(* name of the test *)
	testName	:Tc2_System.T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[createTestName := object.className;
createTestName := Tc2_Standard.CONCAT(
	createTestName,
	Tc2_Standard.CONCAT(
		': ',
		Tc2_Standard.CONCAT( 
			THIS^.getNonQualifiedObjectName(object),
			Tc2_Standard.CONCAT(': ', testName)
		)
	)
);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="deepCloneTest" Id="{e50c2cf6-a292-4399-be2b-903e9e44445c}">
      <Declaration><![CDATA[(*

short summary
=================
Test checks if the ``deepClone`` method works properly,
it performs different tests depending on the clone result

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

parameters
=================

*)

METHOD PRIVATE deepCloneTest
VAR_INPUT
	(* object that should perform the test *)
	object		:CNM_AbstractObject.IObject;
END_VAR
VAR
	clonedObject		:CNM_AbstractObject.IObject;
	result				:CNM_ReturnTypes.CloneResult;
	memoryArea			:Tc2_System.E_TcMemoryArea;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RETURN(NOT TcUnit.TEST_ORDERED(THIS^.createTestName(object, 'deepCloneTest')));

result := object.deepClone(clonedObject => clonedObject);

CASE result OF
CNM_ReturnTypes.CloneResult.CLONE_IS_NOT_SUPPORTED:
	THIS^.AssertTrue(clonedObject = 0, 'object does not support clone output clonedObject must be 0');
CNM_ReturnTypes.CloneResult.FAILED:
	THIS^.AssertTrue(FALSE, 'clone failed');
	THIS^.AssertTrue(clonedObject = 0, 'output clonedObject must be 0');  
CNM_ReturnTypes.CloneResult.SUCCESS:
	THIS^.AssertFalse(object.isEqual(clonedObject), 'cloned object must be NOT equal to source object');
	IF (object.isObjectValid(clonedObject)) THEN
		THIS^.AssertTrue(
			object.className = clonedObject.className,
			'cloned object must have the same class name as source object'
		);
		THIS^.AssertTrue(
			object.address <> clonedObject.address,
			'clonedObject.address must be unequal to the address of the source object.address'
		);
		memoryArea := Tc2_System.F_CheckMemoryArea(pData := clonedObject.address, nSize := SIZEOF(__XWORD));
		THIS^.AssertTrue(
			memoryArea = Tc2_System.E_TcMemoryArea.Dynamic,
			'Tc2_System.F_CheckMemoryArea(clonedObject.address, SIZEOF(__XWORD)) must return Tc2_System.E_TcMemoryArea.Dynamic'
		);
		THIS^.AssertTrue(
			Condition	:= ((clonedObject.address MOD SIZEOF(__XWORD)) = 0),
			Message 	:= 'clonedObject.address modulo SIZEOF(__XWORD) must be 0'
		);
	ELSE
		THIS^.AssertTrue(FALSE,'cloned object must be a valid object');
	END_IF 
	 
ELSE
	THIS^.AssertTrue(FALSE, 'invalid return from clone method');
	THIS^.AssertTrue(clonedObject = 0, 'output clonedObject must be 0'); 
END_CASE

IF (object.isObjectValid(clonedObject)) THEN
	clonedObject.deepDestruct();
END_IF

TcUnit.TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="deepCloneTests" Id="{d8f2ce5e-84af-4717-88ba-ffa74b477aeb}">
      <Declaration><![CDATA[(*

short summary
