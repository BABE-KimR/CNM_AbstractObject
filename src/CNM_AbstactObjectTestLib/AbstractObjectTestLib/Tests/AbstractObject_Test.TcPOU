.. </legal notes>

*)

METHOD PRIVATE deepCloneTests
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.deepCloneTest(THIS^.objectToTest1);
THIS^.deepCloneTest(THIS^.objectToTest2);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{bcba1801-b384-422d-9bb2-2f18c5184f40}">
      <Declaration><![CDATA[(*

short summary
=================
constructor for the test class

.. attention:: 
	``testObject1`` and ``testObject1`` must be two different instances
	and neither of the two objects may be NULL


.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

parameters
=================
:return: is not used

*)

METHOD FB_init :BOOL
VAR_INPUT
	(* if TRUE, the retain variables are initialized (warm start / cold start) *)
    bInitRetains	:BOOL;
	(* if TRUE, the instance afterwards gets moved into the copy code (online change) *)
    bInCopyCode		:BOOL;
	(* first object which should perfom the tests *)
	testObject1 :CNM_AbstractObject.IObject;
	(* second object which should perform the tests *)
	testObject2	:CNM_AbstractObject.IObject;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.objectToTest1 := testObject1;
THIS^.objectToTest2 := testObject2;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="getNonQualifiedObjectName" Id="{870df287-4853-4c75-aa2e-ac538a467cdb}">
      <Declaration><![CDATA[(*

short summary
=================
returns the name of the object without path

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

parameters
=================
:return: object name without path

*)

METHOD PRIVATE getNonQualifiedObjectName :STRING
VAR_INPUT
	object	:CNM_AbstractObject.IObject;
END_VAR
VAR
	name	:Tc2_System.T_MaxString;
	left	:Tc2_System.T_MaxString;
	right	:Tc2_System.T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[name := object.name;
IF (
	Tc2_Utilities.FindAndSplitChar(
		sSeparatorChar	:= '.',
		pSrcString			:= ADR(name),
		pLeftString			:= ADR(left),
		pRightString		:= ADR(right),
		nLeftSize			:= SIZEOF(left),
		nRightSize			:= SIZEOF(right),
		bSearchFromRight	:= TRUE
	)
) THEN
	getNonQualifiedObjectName := right;
ELSE
	getNonQualifiedObjectName := object.name;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="hasHashcode" Id="{5981bc2f-bee5-4c2e-8346-cff470c227a0}">
      <Declaration><![CDATA[(*

short summary
=================
Test if given Object has a hashcode not equal to 0.

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

*)

METHOD PRIVATE hasHashcode
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RETURN(NOT TcUnit.TEST_ORDERED('hasHashcode'));

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.hashcode = 0,
	Message		:= 'objectToTest1.hashcode must be unequal 0');
				
THIS^.AssertFalse(
	Condition 	:= THIS^.objectToTest2.hashcode = 0,
	Message := 'objectToTest2.hashcode must be unequal 0');
 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="hashcodesAreDifferent" Id="{2aa40b41-ec25-4f43-8417-1ec8a19d2931}">
      <Declaration><![CDATA[(*

short summary
=================
Test if both given Objects have a different hashcode.

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

*)

METHOD PRIVATE hashcodesAreDifferent
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RETURN(NOT TcUnit.TEST_ORDERED('hashodesAreDifferent'));

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.hashcode = THIS^.objectToTest2.hashcode,
	Message		:= 'objectToTest1.hashcode must be unequal objectToTest2.hashcode'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.hashcode = THIS^.objectToTest1.hashcode,
	Message		:= 'objectToTest1.hashcode must be equal objectToTest1.hashcode'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest2.hashcode = THIS^.objectToTest2.hashcode,
	Message		:= 'objectToTest2.hashcode must be equal objectToTest2.hashcode'
);

 
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="isEqualToItself" Id="{4025d47a-7bd3-415e-be8b-aee3c5c2af84}">
      <Declaration><![CDATA[(*

short summary
=================
Test if given Object is equal to itself.

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

*)

METHOD PRIVATE isEqualToItself
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RETURN(NOT TcUnit.TEST_ORDERED('isEqualToItself'));
 
THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isEqual(THIS^.objectToTest1),
	Message		:= 'objectToTest1 was unequal to itself, but it should!'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest2.isEqual(THIS^.objectToTest2),
	Message		:= 'objectToTest2 was unequal to itself, but it should!'
);
 
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="isInputValidationSuccessful" Id="{d70825c1-41ea-4dca-be57-f83bcb0b794c}">
      <Declaration><![CDATA[(*

short summary
=================
Tests the validity of the injected objects 
``objectToTest1`` and ``objectToTest2`` to be
able to run the other tests without exceptions


.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

*)

METHOD PRIVATE isInputValidationSuccessful :BOOL
VAR_INPUT
END_VAR
VAR
	addressObject1			:POINTER TO __XWORD;
	addressObject2			:POINTER TO __XWORD;
	memoryAreaObject1		:Tc2_System.E_TcMemoryArea;
	memoryAreaObject2		:Tc2_System.E_TcMemoryArea;
END_VAR
VAR_INST
	returnValue :BOOL := FALSE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[isInputValidationSuccessful := returnValue;
RETURN(NOT TcUnit.TEST_ORDERED('inputValidation'));

THIS^.AssertTrue(
	Condition	:= (THIS^.objectToTest1 <> 0),
	Message		:= 'THIS^.objectToTest1 must be not null to proceed the tests'
);
THIS^.AssertTrue(
	Condition	:= (THIS^.objectToTest2 <> 0),
	Message		:= 'THIS^.objectToTest2 must be not null to proceed the tests'
);

addressObject1 := ADR(THIS^.objectToTest1);

THIS^.AssertTrue(
	Condition	:= (addressObject1^ MOD SIZEOF(__XWORD) = 0),
	Message		:= 'objectToTest1 must point to an alinged address'
);

memoryAreaObject1 := Tc2_System.F_CheckMemoryArea(
	pData := addressObject1^,
	nSize := SIZEOF(__XWORD)
);

THIS^.AssertTrue(
	Condition	:= (memoryAreaObject1 <> Tc2_System.E_TcMemoryArea.Unknown),
	Message		:= 'objectToTest1 must be in a known memory area'
);

addressObject2 := ADR(THIS^.objectToTest2);

THIS^.AssertTrue(
	Condition	:= (addressObject2^ MOD SIZEOF(__XWORD) = 0),
	Message		:= 'objectToTest2 must point to an alinged address'
);

memoryAreaObject2 := Tc2_System.F_CheckMemoryArea(
	pData := addressObject2^,
	nSize := SIZEOF(__XWORD)
);

THIS^.AssertTrue(
	Condition	:= (memoryAreaObject2 <> Tc2_System.E_TcMemoryArea.Unknown),
	Message		:= 'objectToTest2 must be in a known memory area'
);

returnValue := (
	((addressObject1^ MOD SIZEOF(__XWORD)) = 0)
	AND ((addressObject2^ MOD SIZEOF(__XWORD)) = 0)
	AND (THIS^.objectToTest1 <> 0)
	AND (THIS^.objectToTest2 <> 0)
	AND (memoryAreaObject1 <> Tc2_System.E_TcMemoryArea.Unknown)
	AND (memoryAreaObject2 <> Tc2_System.E_TcMemoryArea.Unknown)
);

TcUnit.TEST_FINISHED();
isInputValidationSuccessful := returnValue;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="isNotEqualToOther" Id="{1569b24a-b720-4de0-b4b0-f72aeb27008e}">
      <Declaration><![CDATA[(*

short summary
=================
Test if given Objects are not equal to each other.

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

*)

METHOD PRIVATE isNotEqualToOther
VAR
	object 			:CNM_AbstractObject.IObject;
	stupidObject1	:IStupidObject1;
	stupidObject2	:IStupidObject2;
	stupidObject3	:IStupidObject3;
	stupidObject4	:IStupidObject4;
	stupidObject	:StupidObject();
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RETURN(NOT TcUnit.TEST_ORDERED('isNotEqualToOther'));

stupidObject3	:= stupidObject4;
stupidObject2	:= stupidObject4;
stupidObject1	:= stupidObject4;
object			:= stupidObject4;

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isEqual(THIS^.objectToTest2),
	Message		:= 'objectToTest1.isEqual(objectToTest2) must return FALSE'
);
				
THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest2.isEqual(THIS^.objectToTest1),
	Message		:= 'objectToTest2.isEqual(objectToTest1) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isEqual(object),
	Message		:= 'objectToTest1.isEqual(object) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest2.isEqual(object),
	Message		:= 'objectToTest2.isEqual(object) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isEqual(stupidObject1),
	Message		:= 'objectToTest1.isEqual(stupidObject1) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest2.isEqual(stupidObject1),
	Message		:= 'objectToTest2.isEqual(stupidObject1) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isEqual(stupidObject2),
	Message		:= 'objectToTest1.isEqual(stupidObject2) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest2.isEqual(stupidObject2),
	Message		:= 'objectToTest2.isEqual(stupidObject2) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isEqual(stupidObject3),
	Message		:= 'objectToTest1.isEqual(stupidObject3) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest2.isEqual(stupidObject3),
	Message		:= 'objectToTest2.isEqual(stupidObject3) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest2.isEqual(stupidObject4),
	Message		:= 'objectToTest2.isEqual(stupidObject4) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isEqual(stupidObject4),
	Message		:= 'objectToTest1.isEqual(stupidObject4) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isEqual(stupidObject),
	Message		:= 'objectToTest1.isEqual(stupidObject) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest2.isEqual(stupidObject),
	Message		:= 'objectToTest2.isEqual(stupidObject) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isEqual(object := 0),
	Message		:= 'objectToTest1.isEqual(object := 0) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest2.isEqual(object := 0),
	Message		:= 'objectToTest2.isEqual(object := 0) must return FALSE'
);

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="isValid" Id="{1358229d-fc30-4d7f-80a8-3d694e747e58}">
      <Declaration><![CDATA[(*

short summary
=================
Test if given Object is not null and null tests work.

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

parameters
=================

*)

METHOD PRIVATE isValid
VAR
	object 			:CNM_AbstractObject.IObject;
	stupidObject1	:IStupidObject1;
	stupidObject2	:IStupidObject2;
	stupidObject3	:IStupidObject3;
	stupidObject4	:IStupidObject4;
	stupidObject	:StupidObject();
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RETURN(NOT TcUnit.TEST_ORDERED('isValid'));
				
THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectValid(THIS^.objectToTest1),
	Message		:= 'objectToTest1.isObjectValid(objectToTest1) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectNull(THIS^.objectToTest1),
	Message		:= 'objectToTest1.isObjectNull(objectToTest1) must return FALSE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectValid(object := 0),
	Message		:= 'objectToTest1.isObjectValid(object := 0) must return FALSE'
);
				
THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectNull(object := 0),
	Message		:= 'objectToTest1.isObjectNull(object := 0) must return TRUE'
);

stupidObject3	:= stupidObject4;
stupidObject2	:= stupidObject4;
stupidObject1	:= stupidObject4;
object			:= stupidObject4;

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectValid(stupidObject4),
	Message		:= 'Interface stupidObject4 is empty: objectToTest1.isObjectValid(stupidObject4) must return FALSE'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectNull(stupidObject4),
	Message		:= 'Interface stupidObject4 is empty: objectToTest1.isObjectNull(stupidObject4) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectValid(stupidObject3),
	Message		:= 'stupidObject3 was initialized with the empty interface stupidObject4: objectToTest1.isObjectValid(stupidObject3) must return FALSE'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectNull(stupidObject3),
	Message		:= 'stupidObject3 was initialized with the empty interface stupidObject4: objectToTest1.isObjectNull(stupidObject3) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectValid(stupidObject2),
	Message		:= 'stupidObject2 was initialized with the empty interface stupidObject4: objectToTest1.isObjectValid(stupidObject2) must return FALSE'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectNull(stupidObject2),
	Message		:= 'stupidObject2 was initialized with the empty interface stupidObject4: objectToTest1.isObjectNull(stupidObject2) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectValid(stupidObject1),
	Message		:= 'stupidObject1 was initialized with the empty interface stupidObject4: objectToTest1.isObjectValid(stupidObject1) must return FALSE'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectNull(stupidObject1),
	Message		:= 'stupidObject1 was initialized with the empty interface stupidObject4: objectToTest1.isObjectNull(stupidObject1) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectValid(object),
	Message		:= 'object was initialized with the empty interface stupidObject4: objectToTest1.isObjectValid(object) must return FALSE'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectNull(object),
	Message		:= 'object was initialized with the empty interface stupidObject4: objectToTest1.isObjectNull(object) must return TRUE'
);

stupidObject4	:= stupidObject;
stupidObject3	:= stupidObject4;
stupidObject2	:= stupidObject4;
stupidObject1	:= stupidObject4;
object			:= stupidObject4;

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectValid(stupidObject4),
	Message		:= 'Interface stupidObject4 is initialized with stupidObject: objectToTest1.isObjectValid(stupidObject4) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectNull(stupidObject4),
	Message		:= 'Interface stupidObject4 is initialized with stupidObject: objectToTest1.isObjectNull(stupidObject4) must return FALSE'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectValid(stupidObject3),
	Message		:= 'stupidObject3 was initialized with the valid interface stupidObject4: objectToTest1.isObjectValid(stupidObject3) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectNull(stupidObject3),
	Message		:= 'stupidObject3 was initialized with the valid interface stupidObject4: objectToTest1.isObjectNull(stupidObject3) must return FALSE'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectValid(stupidObject2),
	Message		:= 'stupidObject2 was initialized with the valid interface stupidObject4: objectToTest1.isObjectValid(stupidObject2) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectNull(stupidObject2),
	Message		:= 'stupidObject2 was initialized with the valid interface stupidObject4: objectToTest1.isObjectNull(stupidObject2) must return FALSE'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectValid(stupidObject1),
	Message		:= 'stupidObject1 was initialized with the valid interface stupidObject4: objectToTest1.isObjectValid(stupidObject1) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectNull(stupidObject1),
	Message		:= 'stupidObject1 was initialized with the valid interface stupidObject4: objectToTest1.isObjectNull(stupidObject1) must return FALSE'
);

THIS^.AssertTrue(
	Condition	:= THIS^.objectToTest1.isObjectValid(object),
	Message		:= 'object was initialized with the valid interface stupidObject4: objectToTest1.isObjectValid(object) must return TRUE'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.isObjectNull(object),
	Message		:= 'object was initialized with the valid interface stupidObject4: objectToTest1.isObjectNull(object) must return FALSE'
);

IF (THIS^.objectToTest1.clone(clonedObject => object) = CNM_ReturnTypes.CloneResult.SUCCESS) THEN
	THIS^.AssertTrue(
		Condition	:= THIS^.objectToTest1.isObjectValid(object),
		Message		:= 'object is a clone of THIS^.objectToTest1: objectToTest1.isObjectValid(object) must return TRUE'
	);
	
	THIS^.AssertFalse(
		Condition	:= THIS^.objectToTest1.isObjectNull(object),
		Message		:= 'object is a clone of THIS^.objectToTest1: objectToTest1.isObjectNull(object) must return FALSE'
	);
	IF (object <> 0) THEN
		object.destruct();
	END_IF;
	object := 0;
END_IF

IF (THIS^.objectToTest2.clone(clonedObject => object) = CNM_ReturnTypes.CloneResult.SUCCESS) THEN
	THIS^.AssertTrue(
		Condition	:= THIS^.objectToTest1.isObjectValid(object),
		Message		:= 'object is a clone of THIS^.objectToTest2: objectToTest1.isObjectValid(object) must return TRUE'
	);
	
	THIS^.AssertFalse(
		Condition	:= THIS^.objectToTest1.isObjectNull(object),
		Message		:= 'object is a clone of THIS^.objectToTest2: objectToTest1.isObjectNull(object) must return FALSE'
	);

	IF (object <> 0) THEN
		object.destruct();
	END_IF;
END_IF

TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="validAddress" Id="{cc548ba3-1159-4a14-81d7-43a255773725}">
      <Declaration><![CDATA[(*

short summary
=================
Test if given Objects have an address that is not 0.

.. <legal notes>

legal notes
=================
| SPDX-FileCopyrightText: © 2022 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>

*)

METHOD PRIVATE validAddress
VAR
	memoryArea		:Tc2_System.E_TcMemoryArea;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RETURN(NOT TcUnit.TEST_ORDERED('validAddress'));
 
THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.address = 0,
	Message 	:= 'objectToTest1.address must be unequal 0'
);
				
THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest2.address = 0,
	Message 	:= 'objectToTest2.address must be unequal 0'
);

THIS^.AssertFalse(
	Condition	:= THIS^.objectToTest1.address = THIS^.objectToTest2.address,
	Message 	:= 'objectToTest1.address must be unequal objectToTest2.address'
);

memoryArea := Tc2_System.F_CheckMemoryArea(pData := THIS^.objectToTest1.address, nSize := SIZEOF(__XWORD));

THIS^.AssertFalse(
	Condition	:= memoryArea = Tc2_System.E_TcMemoryArea.Unknown,
	Message 	:= 'Tc2_System.F_CheckMemoryArea(objectToTest1.address, SIZEOF(__XWORD)) must not return Tc2_System.E_TcMemoryArea.Unknown'
);

memoryArea := Tc2_System.F_CheckMemoryArea(pData := THIS^.objectToTest2.address, nSize := SIZEOF(__XWORD));

THIS^.AssertFalse(
	Condition	:= memoryArea = Tc2_System.E_TcMemoryArea.Unknown,
	Message 	:= 'Tc2_System.F_CheckMemoryArea(objectToTest2.address, SIZEOF(__XWORD)) must not return Tc2_System.E_TcMemoryArea.Unknown'
);

THIS^.AssertTrue(
	Condition	:= ((THIS^.objectToTest1.address MOD SIZEOF(__XWORD)) = 0),
	Message 	:= 'objectToTest1.address modulo SIZEOF(__XWORD) must be 0'
);

THIS^.AssertTrue(
	Condition	:= ((THIS^.objectToTest2.address MOD SIZEOF(__XWORD)) = 0),
	Message 	:= 'objectToTest2.address modulo SIZEOF(__XWORD) must be 0'
);
 
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
